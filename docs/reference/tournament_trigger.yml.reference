# Tournament Pipeline Trigger — Cloud Scheduler + Cloud Run Job reference
#
# Tournament mode: runs hourly with mode=auto (default PIPELINE_MODE).
# Active only during WC 2026 (June 11 – July 19).
# Created in PAUSED state; manually resumed at tournament start.
# The Cloud Run Job is the same as the daily trigger; only the schedule differs.
#
# Do NOT use inference_only — that skips B.3 per-round refit at matchday
# boundaries. Both schedules must stay on auto so per-round cadence works.

# -----------------------------------------------------------------------
# 1. Create the Cloud Scheduler entry (one-time, then pause)
# -----------------------------------------------------------------------
# export PROJECT_ID=wc-mlops-predictor
# export REGION=europe-west1
# export SA=wc-mlops-trigger@${PROJECT_ID}.iam.gserviceaccount.com
# export JOB_URI="https://${REGION}-run.googleapis.com/apis/run.googleapis.com/v1/namespaces/${PROJECT_ID}/jobs/wc-mlops-trigger:run"
#
# gcloud scheduler jobs create http wc-pipeline-trigger \
#   --location "$REGION" \
#   --schedule "0 * * * *" \
#   --time-zone "UTC" \
#   --uri "$JOB_URI" \
#   --http-method POST \
#   --oauth-service-account-email "$SA" \
#   --description "WC hourly trigger, mode=auto, Jun 11 - Jul 19"
#
# gcloud scheduler jobs pause wc-pipeline-trigger --location "$REGION"

# -----------------------------------------------------------------------
# 2. Enable at tournament start / disable after
# -----------------------------------------------------------------------
# gcloud scheduler jobs pause  daily-pipeline-trigger --location "$REGION"
# gcloud scheduler jobs resume wc-pipeline-trigger    --location "$REGION"
#
# gcloud scheduler jobs pause wc-pipeline-trigger --location "$REGION"

# -----------------------------------------------------------------------
# 3. Post-WC: pause both schedules
# -----------------------------------------------------------------------
# gcloud scheduler jobs pause daily-pipeline-trigger --location "$REGION"
# gcloud scheduler jobs pause wc-pipeline-trigger    --location "$REGION"
