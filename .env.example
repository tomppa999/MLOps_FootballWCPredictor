# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# API-Football key (https://www.api-football.com/)
API_FOOTBALL_KEY=your_api_football_key_here

# DagsHub credentials (https://dagshub.com)
# Used for MLflow tracking remote and DVC artifact remote.
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_TOKEN=your_dagshub_token

# MLflow tracking (set automatically from DagsHub credentials above)
MLFLOW_TRACKING_URI=https://dagshub.com/<your_username>/<your_repo>.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token

# GCP (only needed for Cloud Run deployment — not required for local runs)
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GCS_BUCKET=your_gcs_bucket_name
